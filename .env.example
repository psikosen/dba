# Shaman's Journey - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# Sentry Configuration (Error Tracking)
# ============================================
# Get your DSN from https://sentry.io/settings/projects/
# Format: https://<key>@o<org-id>.ingest.sentry.io/<project-id>
SENTRY_DSN=

# Environment name (used for Sentry tagging and logging)
# Options: development, staging, production
ENVIRONMENT=development

# ============================================
# Monitoring Configuration
# ============================================
# Port for Prometheus metrics endpoint
PROMETHEUS_PORT=9091

# ============================================
# Grafana Configuration (Staging/Development)
# ============================================
# Admin credentials for Grafana dashboard
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ============================================
# Logging Configuration
# ============================================
# Rust log level
# Options: error, warn, info, debug, trace
# You can also set per-crate levels: RUST_LOG=bevy_shaman=debug,info
RUST_LOG=info

# Enable Rust backtraces (0=disabled, 1=enabled, full=verbose)
RUST_BACKTRACE=1

# ============================================
# Game Configuration (Optional)
# ============================================
# Asset directory path (if not using default ./assets)
# ASSETS_PATH=/path/to/assets

# Save game directory (if not using default ./saves)
# SAVES_PATH=/path/to/saves

# ============================================
# LLM Configuration (Optional)
# ============================================
# Path to LLM model file (for dialogue generation)
# LLM_MODEL_PATH=/path/to/model.gguf

# LLM context size (default: 2048)
# LLM_CONTEXT_SIZE=2048

# ============================================
# Development Tools (Optional)
# ============================================
# Enable debug UI overlays
# DEBUG_UI=false

# Enable performance profiling
# ENABLE_PROFILING=false

# ============================================
# Docker Configuration (Optional)
# ============================================
# Only needed when running in Docker
# DOCKER_HOST_SAVES_PATH=./saves
# DOCKER_HOST_ASSETS_PATH=./assets
